# =====================================================
# Novel2Comic 环境变量配置示例
# =====================================================
# 使用说明：
# 1. 复制此文件为 .env：cp env.example .env
# 2. 修改下面的配置项
# 3. 运行：docker-compose up -d
# =====================================================

# ==================== 端口配置 ====================
# MySQL 端口（默认 3306）
MYSQL_PORT=3306

# Redis 端口（默认 6379）
REDIS_PORT=6379

# 后端 API 端口（默认 8123）
BACKEND_PORT=8123

# 前端端口（默认 80）
FRONTEND_PORT=80

# ==================== 数据库配置 ====================
# MySQL Root 密码（⚠️ 生产环境务必修改！）
MYSQL_ROOT_PASSWORD=Novel2Comic@2025

# MySQL 应用用户密码
MYSQL_PASSWORD=Novel2Comic@2025

# ==================== Redis 配置 ====================
# Redis 密码（留空表示无密码）
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
# JWT 密钥（⚠️ 生产环境务必修改为复杂随机字符串！）
JWT_SECRET=PLEASE-CHANGE-THIS-TO-A-COMPLEX-RANDOM-SECRET-KEY-AT-LEAST-64-CHARACTERS

# ==================== LLM 配置（文本生成）====================
# LLM 提供商：zhipu / deepseek / dashscope
LLM_PROVIDER=zhipu

# 智谱 AI API Key（推荐）
# 获取地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key

# DeepSeek API Key（备选）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# 阿里云通义千问 API Key（备选）
# 获取地址：https://dashscope.console.aliyun.com/
ALIYUN_API_KEY=your-aliyun-api-key

# ==================== AIGC 配置（图片生成）====================
# AIGC 提供商：siliconflow / wanx / mock
AIGC_PROVIDER=siliconflow

# 硅基流动 API Key（推荐）
# 获取地址：https://siliconflow.cn/
SILICONFLOW_API_KEY=your-siliconflow-api-key

# =====================================================
# 注意事项：
# 1. .env 文件不要提交到 Git（已在 .gitignore 中）
# 2. 所有密码和 API Key 在生产环境必须修改
# 3. JWT_SECRET 必须是复杂的随机字符串（至少64位）
# =====================================================

